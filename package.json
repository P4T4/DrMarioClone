{
  "name": "drmario-private-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": "10.11.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names game,web \"pnpm dev:game\" \"pnpm dev:web\"",
    "dev:game": "tsx src/server/main.ts",
    "dev:web": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format:check": "prettier --check \"src/**/*.{astro,css,ts,js}\" \"tests/**/*.{astro,css,ts,js}\" astro.config.mjs eslint.config.js playwright.config.ts tsconfig.json vitest.config.ts vitest.integration.config.ts package.json .prettierrc.json",
    "lint": "eslint src tests astro.config.mjs eslint.config.js playwright.config.ts vitest.config.ts vitest.integration.config.ts",
    "typecheck": "astro check",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.47",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "gsap": "3.15.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "astro": "7.4.10",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "minimatch": "11.0.7"
    }
  }
}
