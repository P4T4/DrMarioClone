---
import { PIECE_PRESENTATIONS } from '../ui/piece-presentations';
import PrivateDuel from '../components/PrivateDuel.astro';

const controls = [
  { keys: '← / →', action: 'Mover una columna' },
  { keys: '↓', action: 'Bajar una fila' },
  { keys: '↑ / X', action: 'Rotar en sentido horario' },
  { keys: 'Z', action: 'Rotar en sentido antihorario' },
  { keys: 'Espacio', action: 'Fijar en la posición más baja' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#172033" />
    <title>Duelo privado online</title>
    <style>
      :root {
        color: #172033;
        background: #fff;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }

      body {
        margin: 0;
      }

      .skip-link {
        position: absolute;
        inset-block-start: 0.5rem;
        inset-inline-start: 0.5rem;
        transform: translateY(-200%);
        padding: 0.5rem 0.75rem;
        color: #fff;
        background: #172033;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      main {
        max-width: 76rem;
        margin-inline: auto;
        padding: 2rem 1rem;
      }

      :focus-visible {
        outline: 3px solid #005fcc;
        outline-offset: 3px;
      }

      .piece-list {
        display: grid;
        gap: 0.75rem;
        padding: 0;
        list-style: none;
      }

      .piece-list li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .piece-icon {
        flex: none;
        width: 2.5rem;
        height: 2.5rem;
        stroke: currentColor;
        stroke-width: 2;
      }

      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.5rem 1rem;
      }

      dt {
        font-weight: 700;
      }

      dd {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Saltar al contenido principal
    </a>
    <main id="main-content">
      <h1>Duelo privado online</h1>
      <p>Invita a otra persona y juega una partida privada sincronizada.</p>
      <PrivateDuel />

      <section aria-labelledby="controls-heading">
        <h2 id="controls-heading">Controles de teclado</h2>
        <dl>
          {controls.map(({ keys, action }) => (
            <>
              <dt>{keys}</dt>
              <dd>{action}</dd>
            </>
          ))}
        </dl>
      </section>

      <section aria-labelledby="pieces-heading">
        <h2 id="pieces-heading">Cómo reconocer las piezas</h2>
        <ul class="piece-list">
          {PIECE_PRESENTATIONS.map((piece) => (
            <li>
              <svg
                class="piece-icon"
                viewBox="0 0 32 32"
                aria-hidden="true"
                focusable="false"
              >
                {piece.kind === 'virus' && (
                  <g>
                    <circle cx="16" cy="16" r="12" fill="none" />
                    <circle cx="12" cy="13" r="1" fill="currentColor" />
                    <circle cx="20" cy="13" r="1" fill="currentColor" />
                    <path d="M11 20c1.5 2 3.2 3 5 3s3.5-1 5-3" fill="none" />
                  </g>
                )}
                {piece.kind === 'capsule' && (
                  <g>
                    <rect
                      x="4"
                      y="9"
                      width="14"
                      height="14"
                      rx="7"
                      fill="none"
                    />
                    <rect
                      x="14"
                      y="9"
                      width="14"
                      height="14"
                      rx="7"
                      fill="none"
                    />
                    <path d="M16 9v14" />
                  </g>
                )}
                {piece.kind === 'obstacle' && (
                  <g>
                    <rect x="5" y="5" width="22" height="22" fill="none" />
                    <path d="m7 7 18 18M25 7 7 25" />
                  </g>
                )}
              </svg>
              <span>
                {piece.kind === 'capsule'
                  ? `${piece.label}: ${piece.shape} ${piece.pattern}.`
                  : `${piece.label}: forma ${piece.shape} con ${piece.pattern}.`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
